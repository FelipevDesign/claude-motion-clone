# Copie este arquivo para ".env" e ajuste.
# Claude no chat: use UMA das opções abaixo.
# 1) Chave da API da Anthropic (pago por uso, aceita imagens anexadas):
ANTHROPIC_API_KEY=
# 2) Sem chave: se a CLI do Claude Code ("claude") estiver instalada e logada, ela é usada automaticamente.
#    Para desligar a CLI: CLAUDE_CLI=off   |   Para outro executável: CLAUDE_CLI=caminho\para\claude.cmd

# Modelos por nível (Rápido / Padrão / Complexo no seletor do chat)
MODEL_QUICK=claude-haiku-5-5
MODEL_DEFAULT=claude-sonnet-5-5
MODEL_COMPLEX=claude-opus-5-5
MAX_TOKENS=32000

PORT=4321
# Pastas (relativas a esta pasta ou absolutas)
DATA_DIR=data
EXPORT_DIR=exports
